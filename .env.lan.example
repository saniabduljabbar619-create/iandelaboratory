# .env for the LAN SERVER PC  (copy to .env on that PC and fill in)
# See docs/LAN_OFFLINE_MODE.md

# Local MySQL on this PC (not Aiven)
DATABASE_URL=mysql+pymysql://solunex:CHANGE_ME@127.0.0.1:3306/solunex_lan?charset=utf8mb4
DB_SSL=false

# Must be IDENTICAL to the cloud's values, so desktop-app logins and
# patient portal codes keep working against either server.
JWT_SECRET=same-as-cloud
PORTAL_SECRET=same-as-cloud
ANTHROPIC_API_KEY=same-as-cloud

# Sync
NODE_ROLE=lan
SYNC_ENABLED=true
SYNC_CLOUD_URL=https://YOUR-CLOUD-API-ADDRESS
SYNC_TOKEN=same-long-random-secret-as-cloud
SYNC_INTERVAL_SECONDS=10
